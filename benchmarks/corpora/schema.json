{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivannovak/lux/benchmarks/corpora/schema.v1.json",
  "title": "Lux benchmark corpus manifest v1",
  "description": "The top-level owner approves every corpus fixture and gold contract; each corpus versions both contracts and pins a non-vacuous minimum case count.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "owner", "corpora"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "corpora": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/corpus" }
    }
  },
  "$defs": {
    "positiveVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "remote",
        "checkoutHints",
        "commit",
        "fixtureSchemaVersion",
        "goldSchemaVersion",
        "minimumCases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "remote": {
          "type": "string",
          "pattern": "^(?:https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?|ssh://git@github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?|git@github\\.com:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?)$"
        },
        "checkoutHints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "fixtureSchemaVersion": { "$ref": "#/$defs/positiveVersion" },
        "goldSchemaVersion": { "$ref": "#/$defs/positiveVersion" },
        "minimumCases": { "$ref": "#/$defs/positiveVersion" }
      }
    }
  }
}
